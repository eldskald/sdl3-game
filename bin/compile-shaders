#!/bin/bash

shadercross="SDL_shadercross/bin/shadercross"
src="src/gpu"
out="res/shaders"

rm -rf $out
mkdir $out
for file in $(find "$src" -type f -name '*.hlsl'); do
    name="$(basename "$file" .hlsl)"

    case "$name" in
        *.vert) stage="vertex" ;;
        *.frag) stage="fragment" ;;
        *.comp) stage="compute" ;;
        *)
            echo "Unknown shader stage for $file, skipping" >&2
            continue
            ;;
    esac

    "$shadercross" "$file" -I "$src" -s HLSL -d SPIRV -t "$stage" -o "$out/$name.spv"
    "$shadercross" "$file" -I "$src" -s HLSL -d DXIL -t "$stage" -o "$out/$name.dxil"
done
