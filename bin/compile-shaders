#!/bin/bash
set -euo pipefail

shadercross="SDL_shadercross/bin/shadercross"

compile() {
    echo "Compiling $3 shaders..."
    local src="$1"
    local out="$2"
    rm -f "$out"/*.spv "$out"/*.dxil
    mkdir -p "$out"
    for file in $(find "$src" -type f -name '*.hlsl'); do
        name="$(basename "$file" .hlsl)"

        case "$name" in
            *.vert) stage="vertex" ;;
            *.frag) stage="fragment" ;;
            *.comp) stage="compute" ;;
            *)
                echo "Unknown shader stage for $file" >&2
                exit 1
                ;;
        esac

        "$shadercross" "$file" -I "$src" -s HLSL -d SPIRV -t "$stage" -o "$out/$name.spv"
        "$shadercross" "$file" -I "$src" -s HLSL -d DXIL -t "$stage" -o "$out/$name.dxil"
    done
    echo "${3^} shaders compiled successfully."
}

compile "src/gpu" "shaders" "main"
compile "tests/mocks/shaders" "tests/mocks/shaders" "test"
